# Local: SQLite persistente en .data/quiz.sqlite. No requiere credenciales.
# Producción en Vercel: configurar una base PostgreSQL persistente.
DATABASE_URL=
# URL HTTPS definitiva del juego, cuando se publique.
NEXT_PUBLIC_APP_URL=
# Opcional para alojar SQLite en un volumen persistente de un servidor Node.
QUIZ_SQLITE_PATH=
# Panel privado: ejecutar node scripts/setup-survey-admin.mjs para generar los valores.
# Configurar estos mismos tres valores como secretos de servidor en Vercel.
SURVEY_ADMIN_USER=
SURVEY_ADMIN_PASSWORD_HASH=
SURVEY_SESSION_SECRET=
